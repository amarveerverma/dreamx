# --- APPLICATION RUNTIME CONFIGURATION ---
ENVIRONMENT="development"
LOG_LEVEL="INFO"
PORT=8000

# --- DATABASE & STORAGE (SUPABASE) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- PAYMENT GATEWAY (Razorpay MVP) ---
RAZORPAY_KEY_ID="rzp_test_yourkey"
RAZORPAY_KEY_SECRET="your-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# --- AI / LLM INFERENCE ---
GEMINI_API_KEY="your-gemini-key"
GEMINI_DEFAULT_MODEL="gemini-1.5-pro-latest"

# --- NOTIFICATION PROVIDERS (Resend) ---
RESEND_API_KEY="re_your_key"
RESEND_FROM_EMAIL="notifications@dreamx.com"

# --- OBSERVABILITY (Sentry) ---
SENTRY_DSN="https://your-dsn@sentry.io/project"

# --- PLATFORM FEATURE FLAGS ---
FLAG_SMART_MATCH_V2_ENABLED=true
FLAG_STRIPE_ENABLED=false
FLAG_REDIS_CACHE_ENABLED=false
FLAG_WHATSAPP_NOTIFICATIONS=false
